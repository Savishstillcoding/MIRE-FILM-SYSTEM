# Copy to .env (dev) or .env.prod (production). Never commit the real file.
APP_NAME="MIRÉ Film"
APP_ENV=production
APP_KEY=                # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://your-domain.example

LOG_CHANNEL=stderr
SESSION_DRIVER=file
CACHE_STORE=file

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=mire
DB_USERNAME=mire
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
WEB_PORT=80

# The Movie Database: API Read Access Token (themoviedb.org → Settings → API)
TMDB_TOKEN=
